# -*- mode: snippet -*-
# name: complex
# key: complex
# --
struct complex {
    double x;
    double y;
    complex(double u=0,double v=0) {
        x=u;
        y=v;
    }
};

complex operator + (const complex &a,const complex &b) {
    return complex(a.x+b.x,a.y+b.y);
}

complex operator - (const complex &a,const complex &b) {
    return complex(a.x-b.x,a.y-b.y);
}

complex operator * (const complex &a,const complex &b) {
    return complex(a.x*b.x-a.y*b.y,a.x*b.y+a.y*b.x);
}